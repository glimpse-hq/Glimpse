{
  "name": "glimpse",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "build": "tsc && bun ./node_modules/vite/bin/vite.js build",
    "test:frontend": "bun --no-install test tests/frontend",
    "typecheck": "tsc --project tsconfig.json",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "locale:pull-task": "bun ./scripts/pull-lokalise-task.mjs",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "tauri": "bun ./scripts/tauri.mjs",
    "screenshots": "bun ./scripts/screenshots/run.mjs",
    "lint": "bun ./node_modules/eslint/bin/eslint.js src/",
    "lint:ci": "bun ./node_modules/eslint/bin/eslint.js src/ --max-warnings 0",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xstate/react": "^6.1.0",
    "framer-motion": "14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "tauri-plugin-macos-permissions-api": "^2.3.0",
    "xstate": "^5.33.3"
  },
  "overrides": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/format-po": "^6.10.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
